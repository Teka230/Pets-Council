{
  "name": "pets-council",
  "displayName": "Pets Council",
  "description": "A Codex workspace with a consultative council of living companions.",
  "version": "0.14.0",
  "publisher": "teka230",
  "license": "MIT",
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:petsCouncil.openCouncil",
    "onCommand:petsCouncil.openOnboarding",
    "onCommand:petsCouncil.runDiagnostics",
    "onCommand:petsCouncil.openContextGraph",
    "onCommand:petsCouncil.addOpenQuestion",
    "onCommand:petsCouncil.resolveOpenQuestion",
    "onCommand:petsCouncil.queryContextGraph",
    "onCommand:petsCouncil.supersedeDecision",
    "onCommand:petsCouncil.openUsageSignals",
    "onCommand:petsCouncil.resetPetPlacements"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "petsCouncil.openCouncil", "title": "Open Council", "category": "Pets Council" },
      { "command": "petsCouncil.openOnboarding", "title": "Open Setup Guide", "category": "Pets Council" },
      { "command": "petsCouncil.runDiagnostics", "title": "Run Product Diagnostics", "category": "Pets Council" },
      { "command": "petsCouncil.openContextGraph", "title": "Open Shared Context Graph", "category": "Pets Council" },
      { "command": "petsCouncil.addOpenQuestion", "title": "Add Open Question", "category": "Pets Council" },
      { "command": "petsCouncil.resolveOpenQuestion", "title": "Resolve Open Question", "category": "Pets Council" },
      { "command": "petsCouncil.queryContextGraph", "title": "Query Shared Context Graph", "category": "Pets Council" },
      { "command": "petsCouncil.supersedeDecision", "title": "Replace Active Decision", "category": "Pets Council" },
      { "command": "petsCouncil.openUsageSignals", "title": "Open Local Suggestion Signals", "category": "Pets Council" },
      { "command": "petsCouncil.resetPetPlacements", "title": "Reset Companion Positions", "category": "Pets Council" }
    ],
    "configuration": {
      "title": "Pets Council",
      "properties": {
        "petsCouncil.codexBinary": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional path to the Codex CLI binary. Falls back to CODEX_BIN, then codex on PATH."
        },
        "petsCouncil.petMotion": {
          "type": "string",
          "enum": ["system", "full", "reduced"],
          "default": "system",
          "description": "Controls companion animation. System follows the operating-system reduced-motion preference."
        },
        "petsCouncil.localRanking.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Opt in to reordering Council suggestions from bounded local accepted, dismissed, and snoozed outcomes. No remote analytics are used."
        }
      }
    },
    "jsonValidation": [{ "fileMatch": "**/pet-pack.json", "url": "./schemas/pet-pack.schema.json" }]
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node --test dist/context.test.js dist/evidence.test.js dist/mockCouncil.test.js dist/webview.test.js dist/council/provider.test.js dist/council/suggestionRanking.test.js dist/memory/contextGraph.test.js dist/memory/usageSignalStore.test.js dist/onboarding/diagnosticReport.test.js dist/pets/petPack.test.js dist/pets/placement.test.js dist/runtime/jsonl.test.js dist/runtime/modelSelection.test.js dist/runtime/client.test.js dist/runtime/service.test.js dist/runtime/councilBridge.test.js dist/runtime/sessionStore.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.100.0",
    "typescript": "^5.9.2"
  }
}
