{
  "name": "pets-council",
  "displayName": "Pets Council",
  "description": "A council of specialized companions for an AI coding workspace.",
  "version": "0.2.0",
  "publisher": "teka230",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:petsCouncil.openCouncil"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "petsCouncil.openCouncil",
        "title": "Open Council",
        "category": "Pets Council"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node --test dist/context.test.js dist/mockCouncil.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.100.0",
    "typescript": "^5.9.2"
  }
}
