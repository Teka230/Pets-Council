{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pets-council.dev/schemas/pet-pack.schema.json",
  "title": "Pets Council Pet Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "pets", "assignments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "pets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "glyph", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "glyph": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "petId"],
        "properties": {
          "role": { "enum": ["architect", "guardian", "strategist", "notetaker"] },
          "petId": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
