{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pets-council.dev/schemas/pet-pack.schema.json",
  "title": "Pets Council Pet Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "pets", "assignments"],
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "row"],
      "properties": {
        "column": { "type": "integer", "minimum": 0 },
        "row": { "type": "integer", "minimum": 0 }
      }
    },
    "atlas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "dataUri", "cellWidth", "cellHeight", "columns", "rows", "states"],
      "properties": {
        "format": { "enum": ["strip-v1", "hatch-v2"] },
        "dataUri": { "type": "string", "pattern": "^data:image/" },
        "cellWidth": { "type": "integer", "minimum": 1 },
        "cellHeight": { "type": "integer", "minimum": 1 },
        "columns": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "states": {
          "type": "object",
          "additionalProperties": false,
          "required": ["idle", "thinking", "suggestion", "silent", "approval", "error"],
          "properties": {
            "idle": { "$ref": "#/$defs/cell" },
            "thinking": { "$ref": "#/$defs/cell" },
            "suggestion": { "$ref": "#/$defs/cell" },
            "silent": { "$ref": "#/$defs/cell" },
            "approval": { "$ref": "#/$defs/cell" },
            "error": { "$ref": "#/$defs/cell" }
          }
        }
      }
    },
    "artwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "version", "license", "attribution"],
      "properties": {
        "tier": { "const": "canonical" },
        "version": { "type": "integer", "minimum": 1 },
        "license": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "pets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "glyph", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "glyph": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "atlas": { "$ref": "#/$defs/atlas" },
          "artwork": { "$ref": "#/$defs/artwork" }
        }
      }
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "petId"],
        "properties": {
          "role": { "enum": ["architect", "guardian", "strategist", "notetaker"] },
          "petId": { "type": "string", "minLength": 1 },
          "anchor": { "enum": ["editor", "terminal", "sidebar", "memory"] }
        }
      }
    }
  }
}
