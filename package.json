{
  "name": "pets-council-workspace",
  "version": "0.1.0-preview.1",
  "private": true,
  "description": "A Code - OSS distribution where Codex answers, living companions review, and the user decides.",
  "license": "MIT",
  "workspaces": ["extensions/pets-council"],
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "node scripts/check-environment.mjs",
    "build": "npm run build --workspace pets-council",
    "typecheck": "npm run typecheck --workspace pets-council",
    "test": "npm run test --workspace pets-council",
    "bootstrap": "node scripts/bootstrap-code-oss.mjs",
    "sync:extension": "node scripts/sync-extension.mjs",
    "native:apply": "node scripts/apply-native-overlay.mjs",
    "native:verify": "node scripts/verify-native-overlay.mjs",
    "native:verify-source": "node scripts/verify-native-overlay.mjs --source",
    "product:brand": "node scripts/apply-product-branding.mjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs --compile-only",
    "desktop:launch": "node scripts/desktop-smoke.mjs",
    "package:preview:prepare": "node scripts/package-preview.mjs --prepare-only",
    "package:preview": "node scripts/package-preview.mjs"
  }
}
